{
  "manifest_version": 1,
  "repository": {
    "name": "webex-js-sdk",
    "purpose": "Cisco Webex JavaScript SDK — a multi-package yarn workspace providing browser and Node clients and plugins for Webex messaging, meetings, calling, and related services.",
    "category": "cat1-legacy",
    "primary_languages": [
      "JavaScript",
      "TypeScript"
    ]
  },
  "topology": "Multi-repo-workspace",
  "toolchain": [
    {
      "name": "node",
      "version": "18.x",
      "origin": "repo-config",
      "source_file": "package.json (engines.node); .nvmrc=lts/jod"

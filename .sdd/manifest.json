{
  "manifest_version": 1,
  "repository": {
    "name": "webex-js-sdk",
    "purpose": "JavaScript SDK for interacting with the Webex API — a Yarn-workspaces monorepo of public and internal plugins (meetings, calling, contact-center, people, messages, encryption, mercury, and shared core/infrastructure) built on the @webex/webex-core plugin framework.",
    "category": "cat1-legacy",
    "primary_languages": [
      "typescript",
      "javascript"
    ]
  },
  "topology": "Multi-repo-workspace",
  "commands": {
    "install": {
      "command": "yarn install",
      "source_file": "package.json",
      "role": "install"
    },
    "build": {
      "command": "yarn build",
      "source_file": "package.json",
      "role": "package"
    },
    "build_package": {
      "command": "yarn workspace @webex/<plugin-name> build:src",
      "source_file": "AGENTS.md",
      "role": "package"
    },
    "test_unit": {
      "command": "yarn workspace @webex/<plugin-name> test:unit",
      "source_file": "AGENTS.md",
      "role": "unit-test"
    },
    "test_integration": {
      "command": "yarn test:integration",
      "source_file": "package.json",
      "role": "integration-test"
    },
    "lint": {
      "command": "yarn lint",
      "source_file": "package.json",
      "role": "lint"
    },
    "test_e2e": {
      "command": "yarn test:e2e",
      "source_file": "package.json",
      "role": "e2e-test"
    },
    "docs": {
      "command": "yarn build:docs",
      "source_file": "package.json",
      "role": "docs"
    }
  },
  "toolchain": [
    {
      "name": "node",
      "version": "18.x",
      "origin": "repo-config",
      "source_file": "package.json"
    },
    {
      "name": "npm",
      "version": ">=10.5",
      "origin": "repo-config",
      "source_file": "package.json"
    },
    {
      "name": "yarn",
      "version": "3.4.1",
      "origin": "repo-config",
      "source_file": "package.json"
    }
  ],

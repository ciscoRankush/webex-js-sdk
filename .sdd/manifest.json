    {
      "name": "yarn",
      "version": "3.4.1",
      "origin": "repo-config",
      "source_file": "package.json (packageManager); .yarnrc.yml (yarnPath)"
    },
    {
      "name": "npm",
      "version": ">=10.5",
      "origin": "repo-config",
      "source_file": "package.json (engines.npm)"
    }
  ],
  "registries": [
    {
      "name": "npmjs",
      "type": "npm",
      "host": "https://registry.npmjs.org",
      "settings_file": ".yarnrc.yml",
      "auth_env": [],
      "origin": "repo-config"
    }
  ],
  "commands": {
    "install": {
      "command": "yarn",
      "source_file": "package.json / .yarnrc.yml",
      "role": "install"
    },
    "build": {
      "command": "yarn build",
      "source_file": "package.json scripts.build",
      "role": "build"
    },
    "build:local": {
      "command": "yarn build:local",
      "source_file": "package.json scripts.build:local",
      "role": "build"
    },
    "test": {
      "command": "yarn test",
      "source_file": "package.json scripts.test (node ./tooling/index.js test)",
      "role": "other"
    },
    "test:unit": {
      "command": "yarn test:unit",
      "source_file": "package.json scripts.test:unit",
      "role": "unit-test"
    },
    "test:integration": {
      "command": "yarn test:integration",
      "source_file": "package.json scripts.test:integration",
      "role": "integration-test"
    },
    "lint": {
      "command": "yarn lint",
      "source_file": "package.json scripts.lint (eslint .)",
      "role": "lint"
    },
    "build:docs": {
      "command": "yarn build:docs",
      "source_file": "package.json scripts.build:docs",
      "role": "other"
    },
    "release": {
      "command": "yarn release",
      "source_file": "package.json scripts.release (standard-version)",
      "role": "other"
    }
  },
  "tests": {
    "unit": {
      "command_ref": "test:unit",
      "dir": "packages/**/test/unit",
      "framework": "Mocha/Karma + Jest (per package)"
    },
    "integration": {
      "command_ref": "test:integration",
      "dir": "packages/**/test/integration",
      "framework": "Karma/browser"
    },
    "e2e": {
      "dir": "docs/samples; wdio.helpers.d",
      "framework": "WebdriverIO"
    }
  },
